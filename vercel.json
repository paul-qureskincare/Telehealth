{
  "headers": [
    {
      "source": "/api/embed-proxy",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/embed-proxy",
      "destination": "/api/embed-proxy"
    }
  ]
}
